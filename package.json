{
  "name": "dsh-todo-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sidebar Todo panel for DSH: a private, human-only checklist with create, edit, complete, delete, priority and due dates. Registers no agent tools and no prompt text.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "license": "Apache-2.0"
}
